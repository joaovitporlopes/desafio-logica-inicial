function calcularRankeada(vitorias, derrotas) {
  // Cálculo do saldo de rankeadas
  let saldoVitorias = vitorias - derrotas;

  // Variável que vai armazenar o nível/rank
  let nivel = "";

  // Estruturas de decisão para definir o rank com base nas vitórias
  if (vitorias < 10) {
    nivel = "Ferro";
  } else if (vitorias >= 11 && vitorias <= 20) {
    nivel = "Bronze";
  } else if (vitorias >= 21 && vitorias <= 50) {
    nivel = "Prata";
  } else if (vitorias >= 51 && vitorias <= 80) {
    nivel = "Ouro";
  } else if (vitorias >= 81 && vitorias <= 90) {
    nivel = "Diamante";
  } else if (vitorias >= 91 && vitorias <= 100) {
    nivel = "Lendário";
  } else if (vitorias >= 101) {
    nivel = "Imortal";
  }

  // Retorna um objeto com o saldo e o nível
  return { saldoVitorias, nivel };
}

// Lista de jogadores para testar a função (uso de laço de repetição)
const jogadores = [
  { nome: "Herói 1", vitorias: 5, derrotas: 2 },
  { nome: "Herói 2", vitorias: 15, derrotas: 4 },
  { nome: "Herói 3", vitorias: 35, derrotas: 10 },
  { nome: "Herói 4", vitorias: 60, derrotas: 20 },
  { nome: "Herói 5", vitorias: 85, derrotas: 30 },
  { nome: "Herói 6", vitorias: 95, derrotas: 25 },
  { nome: "Herói 7", vitorias: 110, derrotas: 40 },
];

// Laço de repetição para processar cada jogador
for (let i = 0; i < jogadores.length; i++) {
  const jogador = jogadores[i];
  const resultado = calcularRankeada(jogador.vitorias, jogador.derrotas);

  console.log(
    `O herói ${jogador.nome} tem de saldo de **${resultado.saldoVitorias}** e está no nível de **${resultado.nivel}**`
  );
}
